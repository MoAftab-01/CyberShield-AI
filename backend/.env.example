APP_NAME=CyberShield AI
APP_VERSION=1.0.0
ENVIRONMENT=production

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cybershield
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://cybershieldai-security.vercel.app

# Must be at least 32 random characters. The app warns on anything shorter and
# refuses to start on an algorithm outside HS256/HS384/HS512.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=replace_with_your_own_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=openai/gpt-oss-20b
GROQ_BASE_URL=https://api.groq.com/openai/v1

VT_API_KEY=

LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Retrieval
#
# The defaults below are the shipped configuration and are the ones the
# evaluation harness measured. They are listed here so they can be changed
# without a code edit, but changing one invalidates the measured numbers:
# re-run `python evaluate_benchmarks.py` before trusting the change.
# ---------------------------------------------------------------------------

# Uploads
MAX_UPLOAD_BYTES=15728640

# Embeddings. `auto` prefers the ONNX model and falls back to hashing.
# Set to `hash` to disable semantic search (what the test suite does, so it
# needs no model download).
EMBEDDING_BACKEND=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where the model weights are cached. Point this at a persistent path in a
# container so a restart does not re-download ~90MB.
EMBEDDING_CACHE_DIR=

# Memory `auto` requires before it will load the semantic model, in MB. The
# ONNX runtime plus the encoder is ~300MB resident, and a 512MB instance is
# OOM-killed loading it - before the port binds, so the deploy fails outright
# rather than degrading. 900 leaves a 512MB free tier on hashing and still
# gives a 1GB+ instance semantic search. Lower it only if the instance really
# has the headroom. `EMBEDDING_BACKEND=fastembed` bypasses this check.
EMBEDDING_MEMORY_FLOOR_MB=900

# Chunking. 600/100 measured better than 800/150 on the labelled set.
RAG_CHUNK_SIZE=600
RAG_CHUNK_OVERLAP=100

# Fusion. `on` runs hybrid (BM25 + dense + RRF). `off`/`dense`/`semantic`
# run dense only. Hybrid won on every metric at every chunk size tested.
RAG_FUSION=on
RAG_RRF_K=60

# Reranking weights.
RAG_RERANK_RRF_WEIGHT=0.30
RAG_RERANK_SEMANTIC_WEIGHT=0.55
RAG_RERANK_COVERAGE_WEIGHT=0.15
RAG_MMR_LAMBDA=0.72

# Candidate pool sizes: plain queries, and queries filtered by upload scope.
RAG_POOL_MULTIPLIER_PLAIN=8
RAG_POOL_MULTIPLIER_FILTERED=20

# Relevance floor. Measured to be inert on the labelled set - it changes
# nothing at these values. Left on as a guard against a pathological query.
RAG_FLOOR_TRIGGER_COVERAGE=0.5
RAG_FLOOR_MINIMUM=0.35
RAG_FLOOR_FRACTION=0.5

# Answer-path gate. Measured: unrelated questions peak at 0.2046, security
# questions start at 0.3082, knowledge-base questions start at 0.5644.
RAG_IRRELEVANT_BELOW=0.30
RAG_DOCUMENT_AT_LEAST=0.55
