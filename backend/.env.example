APP_NAME=CyberShield AI
APP_VERSION=1.0.0
ENVIRONMENT=production

DATABASE_URL=postgresql://postgres:postgres@postgres:5432/cybershield
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174,https://cybershieldai-security.vercel.app

JWT_SECRET=replace_with_your_own_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

LLM_PROVIDER=groq
GROQ_API_KEY=replace_with_your_groq_api_key
GROQ_MODEL=llama-3.1-8b-instant
GROQ_BASE_URL=https://api.groq.com/openai/v1

VT_API_KEY=

LOG_LEVEL=INFO
